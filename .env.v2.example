# ReachAgent V2 only. Copy to .env.v2.local and obtain local keys with:
# npx supabase status --workdir supabase-v2
REACHAGENT_ENV=local_v2
NEXT_PUBLIC_REACHAGENT_RUNTIME=v2
V2_DEPLOYMENT_BRANCH=reachagent-v2-application
V2_VERCEL_PROJECT_NAME=
NEXT_PUBLIC_REACHAGENT_V2_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# V2 side effects are denied unless deliberately enabled outside this baseline.
OUTREACH_SEND_ENABLED=false
TRIGGER_JOBS_ENABLED=false
HOSTINGER_MUTATIONS_ENABLED=false
FINDER_SCHEDULE_ENABLED=false
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_SHADOW=false
V2_SHADOW_ALLOW_PRODUCTION_READS=false
SHADOW_OBSERVABILITY_WRITE_ENABLED=false

# V2 tiny canary (initial send only). Enable only for an operator-controlled,
# individually approved one-lead execution window; keep false otherwise.
V2_CANARY_ENABLED=false
V2_CANARY_LEAD_IDS=
V2_CANARY_APPROVAL_TOKEN=
V2_CANARY_APPROVED_CONTENT_HASH=
V2_CANARY_APPROVAL_REFERENCE=
V2_SHADOW_SUPABASE_URL=
V2_SHADOW_SUPABASE_READ_KEY=
V2_SHADOW_SUPABASE_PUBLISHABLE_KEY=
V2_SHADOW_SUPABASE_ACCESS_TOKEN=
V2_SHADOW_SUPABASE_SCHEMA=

# Bounded worker reads. Values above the code-enforced maxima are clamped.
RESEARCHER_BATCH_SIZE=100
BOUNCED_EMAIL_REPAIR_BATCH_SIZE=25
WRITER_BATCH_SIZE=100
WRITER_STALE_RESET_BATCH_SIZE=200
REACTIVATION_BATCH_SIZE=100

# Optional local-only integrations. Never copy production secrets here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OUTSCRAPER_API_KEY=
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
RESEND_API_KEY_V2=
RESEND_WEBHOOK_SECRET=
HOSTINGER_WEBHOOK_SECRET=
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_ID=
HOSTINGER_MAILBOX_ADDRESS=
HOSTINGER_MAIL_API_BASE_URL=
# SaaS 5 mailbox OAuth. Generate the encryption key outside source control:
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
MAILBOX_CREDENTIAL_ENCRYPTION_KEY=
MAILBOX_OAUTH_REDIRECT_BASE_URL=http://localhost:3000
GOOGLE_MAILBOX_CLIENT_ID=
GOOGLE_MAILBOX_CLIENT_SECRET=
MICROSOFT_MAILBOX_CLIENT_ID=
MICROSOFT_MAILBOX_CLIENT_SECRET=
MICROSOFT_MAILBOX_TENANT_ID=common
TRIGGER_SECRET_KEY=
TRIGGER_V2_PROJECT_REF=
TRIGGER_SECRET_KEY_PROD=
TRIGGER_PROJECT_ID=
SUPABASE_URL=
SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_URL_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=
V1_SUPABASE_URL=
V1_SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ENABLE_SENDER=
ENABLE_FOLLOWUP=
TRIGGER_ACCESS_TOKEN=
RESEND_API_KEY_Gmail=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SaaS 7 Stripe billing (test mode only). Obtain from the Stripe test dashboard.
# A publishable key is not required: Checkout and the Customer Portal use
# server-created session URLs, so no Stripe.js is loaded in the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=

# Disposable local admin bootstrap only.
V2_BOOTSTRAP_ADMIN_EMAIL=
V2_BOOTSTRAP_ADMIN_PASSWORD=
HOSTINGER_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
RESEND_INBOUND_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
